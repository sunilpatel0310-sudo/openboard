<?xml version="1.0" encoding="utf-8"?>
<!-- Accurate Gujarati Barakhadi to English Phonetic Mapping -->
<Keyboard xmlns:latin="http://schemas.android.com/apk/res-auto">
    <!-- Row 1: કંઠ્ય અને તાલવ્ય વ્યંજન -->
    <Row>
        <Key latin:keySpec="ક" latin:keyOutputText="k" />
        <Key latin:keySpec="ખ" latin:keyOutputText="kh" />
        <Key latin:keySpec="ગ" latin:keyOutputText="g" />
        <Key latin:keySpec="ઘ" latin:keyOutputText="gh" />
        <Key latin:keySpec="ચ" latin:keyOutputText="ch" />
        <Key latin:keySpec="છ" latin:keyOutputText="chh" />
        <Key latin:keySpec="જ" latin:keyOutputText="j" />
        <Key latin:keySpec="ઝ" latin:keyOutputText="jh" />
        <Key latin:keySpec="ટ" latin:keyOutputText="t" />
        <Key latin:keySpec="ઠ" latin:keyOutputText="th" />
    </Row>

    <!-- Row 2: મૂર્ધન્ય, દંત્ય અને ઓષ્ઠ્ય વ્યંજન -->
    <Row>
        <Key latin:keySpec="ડ" latin:keyOutputText="d" />
        <Key latin:keySpec="ઢ" latin:keyOutputText="dh" />
        <Key latin:keySpec="ણ" latin:keyOutputText="n" />
        <Key latin:keySpec="ત" latin:keyOutputText="t" />
        <Key latin:keySpec="થ" latin:keyOutputText="th" />
        <Key latin:keySpec="દ" latin:keyOutputText="d" />
        <Key latin:keySpec="ધ" latin:keyOutputText="dh" />
        <Key latin:keySpec="ન" latin:keyOutputText="n" />
        <Key latin:keySpec="પ" latin:keyOutputText="p" />
        <Key latin:keySpec="ફ" latin:keyOutputText="ph" />
    </Row>

    <!-- Row 3: અન્ય વ્યંજન અને જોડાક્ષર -->
    <Row>
        <Key latin:keySpec="બ" latin:keyOutputText="b" />
        <Key latin:keySpec="ભ" latin:keyOutputText="bh" />
        <Key latin:keySpec="મ" latin:keyOutputText="m" />
        <Key latin:keySpec="ય" latin:keyOutputText="y" />
        <Key latin:keySpec="ર" latin:keyOutputText="r" />
        <Key latin:keySpec="લ" latin:keyOutputText="l" />
        <Key latin:keySpec="વ" latin:keyOutputText="v" />
        <Key latin:keySpec="શ" latin:keyOutputText="sh" />
        <Key latin:keySpec="ષ" latin:keyOutputText="sh" />
        <Key latin:keySpec="સ" latin:keyOutputText="s" />
    </Row>

    <!-- Row 4: અલ્પપ્રાણ, મહાપ્રાણ અને બારાક્ષરી માત્રાઓ (Vowel Signs) -->
    <Row>
        <Key latin:keySpec="હ" latin:keyOutputText="h" />
        <Key latin:keySpec="ળ" latin:keyOutputText="l" />
        <Key latin:keySpec="ક્ષ" latin:keyOutputText="ksh" />
        <Key latin:keySpec="જ્ઞ" latin:keyOutputText="gn" />
        <!-- માત્રાઓ: આ અક્ષરો વ્યંજન પાછળ લાગીને સાચો સ્પેલિંગ બનાવશે -->
        <Key latin:keySpec="ા" latin:keyOutputText="a" />
        <Key latin:keySpec="િ" latin:keyOutputText="i" />
        <Key latin:keySpec="ી" latin:keyOutputText="ee" />
        <Key latin:keySpec="ુ" latin:keyOutputText="u" />
        <Key latin:keySpec="ૂ" latin:keyOutputText="oo" />
        <Key latin:keySpec="ે" latin:keyOutputText="e" />
        <Key latin:keySpec="ૈ" latin:keyOutputText="ai" />
        <Key latin:keySpec="ો" latin:keyOutputText="o" />
        <Key latin:keySpec="ૌ" latin:keyOutputText="au" />
        <Key latin:keySpec="ં" latin:keyOutputText="n" />
    </Row>
</Keyboard>
