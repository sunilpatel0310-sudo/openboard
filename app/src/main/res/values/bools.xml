<resources>
    <!-- Default Locale Settings -->
    <bool name="im_is_default">false</bool>

    <!-- Basic Custom Layouts -->
    <bool name="config_default_number_row">true</bool>
    <bool name="config_default_space_trackpad">true</bool>
    <bool name="config_default_delete_swipe">true</bool>

    <!-- Theme & Visual Styling -->
    <bool name="config_default_amoled_mode">true</bool>
    <bool name="config_default_key_borders">true</bool>
    <bool name="config_default_popup_on_keypress">true</bool>

    <!-- Keypress Sound -->
    <bool name="config_default_sound_on_keypress">true</bool>

