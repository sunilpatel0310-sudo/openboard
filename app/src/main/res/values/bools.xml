    <bool name="config_default_autospace_after_punctuation">true</bool>
    <bool name="config_default_use_double_space_period">true</bool>
    <bool name="config_default_gesture_preview_trail">true</bool>

    <!-- Language & Input Switches -->
    <bool name="config_default_long_press_space_to_change_lang">true</bool>
    <bool name="config_default_show_language_switch_key">true</bool>
</resources>
